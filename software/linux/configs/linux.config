CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_MMU is not set
CONFIG_RISCV_M_MODE=y
CONFIG_SOC_ZCORE=y
# CONFIG_SMP is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBS is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZIHINTPAUSE is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_SBI is not set
# CONFIG_EFI is not set
# CONFIG_MODULES is not set
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x10000000
CONFIG_HZ_100=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_BINFMT_FLAT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_SERIAL_ZCORE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PERF_EVENTS=y
# CONFIG_RISCV_PMU is not set
# CONFIG_RISCV_PMU_LEGACY is not set
CONFIG_TMPFS=y
CONFIG_PRINTK_TIME=y
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_RANDOMIZE_KSTACK_OFFSET is not set
CONFIG_CMDLINE="earlycon=zcore,mmio32,0x04000000 console=ttyZC0,115200 loglevel=8 rdinit=/init"
CONFIG_CMDLINE_EXTEND=y
